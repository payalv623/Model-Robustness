  "visual_inspection": {
    "artifact": "reports/color_readiness/transformation_samples.png",
    "scope": "One training image per class; original, red, blue and grayscale previews. Not a full label audit.",
    "observations": [
      "Both tints preserve visible image structure and recolor the whole frame, including the background.",
      "Some sampled objects are small, occluded, or accompanied by people; notably the tench and Komodo dragon examples. Background segmentation must verify the target animal is selected rather than another foreground object.",
      "A red overlay need not make the red channel dominant when the original image is strongly blue. Assignment correctness is verified by the blend equation, not channel dominance."
    ]
  }
